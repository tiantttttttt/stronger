{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "swagger": "2.0",
    "info": {
        "description": "居家力量训练记录 API。",
        "title": "Stronger API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/auth/dev/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "开发测试登录（仅 DEBUG=true）",
                "parameters": [
                    {
                        "description": "开发登录请求",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/requests.DevLogin"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.Login"
                        }
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "auth"
                ],
                "summary": "获取当前用户身份",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.Identity"
                        }
                    }
                }
            }
        },
        "/api/v1/workouts": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "workouts"
                ],
                "summary": "创建空训练",
                "parameters": [
                    {
                        "description": "创建请求",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/requests.CreateWorkout"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.WorkoutRecord"
                        }
                    }
                }
            }
        },
        "/api/v1/workouts/{id}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "workouts"
                ],
                "summary": "更新训练状态",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "训练 UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "更新请求",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.UpdateWorkout"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.WorkoutRecord"
                        }
                    }
                }
            }
        },
        "/api/v1/workouts/{id}/stat": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "workouts"
                ],
                "summary": "查询已完成训练统计",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "训练 UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.WorkoutStat"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "health"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.Health"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "requests.CreateWorkout": {
            "type": "object"
        },
        "requests.DevLogin": {
            "type": "object",
            "properties": {
                "user_id": {
                    "type": "string",
                    "example": "00000000-0000-0000-0000-000000000001"
                }
            }
        },
        "requests.UpdateWorkout": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "description": "当前仅支持更新为已完成。",
                    "type": "integer",
                    "enum": [
                        2
                    ]
                }
            }
        },
        "responses.Health": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "database_unavailable"
                },
                "database": {
                    "type": "string",
                    "example": "ok"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "responses.Identity": {
            "type": "object",
            "properties": {
                "user_id": {
                    "type": "string"
                }
            }
        },
        "responses.Login": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "responses.WorkoutRecord": {
            "type": "object",
            "properties": {
                "completed_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "started_at": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                }
            }
        },
        "responses.WorkoutStat": {
            "type": "object",
            "properties": {
                "completed_at": {
                    "type": "string"
                },
                "completed_exercise_count": {
                    "type": "integer"
                },
                "completed_set_count": {
                    "type": "integer"
                },
                "duration_seconds": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "started_at": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "total_reps": {
                    "type": "integer"
                },
                "total_volume_kg": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "填写 Bearer \u003caccess_token\u003e。",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}